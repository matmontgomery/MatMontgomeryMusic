{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "matmontgomerymusic",
	"compatibility_date": "2026-11-05",
	"compatibility_flags": ["nodejs_compat", "nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"vars": {
		"CONTACT_EMAIL": "mathewglenn@gmail.com",
		"MAIL_FROM": "Mat Montgomery <contact@matmontgomerymusic.com>",
		"PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAFX8gZ880xFkOpEj"
	},
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": false,
			"head_sampling_rate": 1,
			"persist": true
		},
		"issue_detection": {
			"enabled": false
		}
	},
	"workers_dev": true,
	"preview_urls": true
}
